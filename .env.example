# ============================================================
# ShopEase Environment Configuration (.env.example)
# ============================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=shopease
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/shopease

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=shopease-super-secret-jwt-key-for-qa-portfolio-2026
JWT_EXPIRES_IN=24h

# Frontend API Endpoint (for Vite development)
VITE_API_URL=http://localhost:5000/api

